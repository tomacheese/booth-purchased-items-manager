{
  "name": "booth-purchased-items-manager",
  "description": "",
  "version": "0.0.0",
  "author": "Tomachi <tomachi@tomacheese.com>",
  "bugs": {
    "url": "https://github.com/tomacheese/booth-purchased-items-manager/issues"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.68",
    "@book000/node-utils": "1.25.115",
    "@jest/globals": "30.5.2",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.7",
    "@types/yauzl": "3.4.0",
    "eslint": "10.10.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-promise": "7.3.0",
    "jest": "30.5.2",
    "jest-expect-message": "1.1.3",
    "node-html-parser": "9.0.4",
    "prettier": "3.9.8",
    "puppeteer-core": "25.11.0",
    "run-z": "2.1.0",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-json-schema": "0.68.0"
  },
  "homepage": "https://github.com/tomacheese/booth-purchased-items-manager",
  "license": "MIT",
  "main": "dist/main.js",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "private": true,
  "repository": {
    "url": "git@github.com:tomacheese/booth-purchased-items-manager.git",
    "type": "git"
  },
  "scripts": {
    "dev": "tsx watch ./src/main.ts",
    "fix": "run-z fix:prettier fix:eslint",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "fix:prettier": "prettier --write src",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "lint:prettier": "prettier --check src",
    "lint:tsc": "tsc",
    "preinstall": "npx only-allow pnpm",
    "start": "tsx ./src/main.ts",
    "generate-schema": "typescript-json-schema --required src/config.ts ConfigInterface -o schema/Configuration.json",
    "test": "NODE_ENV=test jest --runInBand --passWithNoTests --detectOpenHandles --forceExit"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testMatch": [
      "**/*.test.ts"
    ],
    "setupFilesAfterEnv": [
      "jest-expect-message"
    ]
  },
  "dependencies": {
    "iconv-lite": "0.7.3",
    "jsonc-parser": "3.3.1",
    "yauzl": "3.4.0"
  }
}
